# SurveyPro / Survey Desk — environment template
#
# Copy this file to .env and fill in the values. .env is git-ignored; this template is not,
# so it must never contain a working credential. Everything here is a placeholder.
#
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# .env is loaded once at boot (dotenv in server.js), so every change needs a server restart.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# development | production — production turns off the local mail preview below.
NODE_ENV=development
# Public address of this app. Used to build the links that go into email, so a
# localhost value here produces links that only open on this machine.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Contains a password, therefore a secret: never commit a real one.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# require | verify-full — set when the database is reached over TLS.
PGSSLMODE=

# ---------------------------------------------------------------------------
# Secrets — each must be a distinct random value
# ---------------------------------------------------------------------------
# Signs and rotates with SESSION_SECRET logs every browser out.
SESSION_SECRET=REPLACE_WITH_GENERATED_VALUE
# Currently only a fallback for SESSION_SECRET (jsonwebtoken is not used by any route);
# keep it set and distinct so no code path can fall back to a published default.
JWT_SECRET=REPLACE_WITH_GENERATED_VALUE
# HMAC key for the session/verification/reset token digests (db/index.js). If it is unset,
# the code falls back to a value derived from SESSION_SECRET — set it explicitly instead.
TOKEN_PEPPER=REPLACE_WITH_GENERATED_VALUE

# ---------------------------------------------------------------------------
# First administrator, seeded on an empty database (db/index.js)
# ---------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Password rules in server.js: 12+ characters with upper, lower, digit and symbol.

# ---------------------------------------------------------------------------
# Mailboxes that sign in through Google as the administrator (server.js)
# ---------------------------------------------------------------------------
# Comma-separated. Decides the role only when Google's callback creates an account for the first
# time; an account that already exists keeps whatever an administrator set it to.
ADMIN_GOOGLE_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# Session and token policy (all optional — these are the built-in defaults)
# ---------------------------------------------------------------------------
SESSION_HOURS=8
REMEMBER_ME_DAYS=30
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Outgoing mail — verification, password reset, security alerts
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
# An app password, not the account password, when the provider requires one.
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Survey Desk <you@example.com>"
# When SMTP is not configured, activation and reset links are printed to the console instead
# of mailed. Set to off to disable that even without SMTP, so a token never lands in a log file.
MAIL_PREVIEW=

# ---------------------------------------------------------------------------
# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials)
# ---------------------------------------------------------------------------
# The client ID alone is public, but it is deployed-specific; the pair with the secret is not.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Must match an authorised redirect URI on the OAuth client exactly.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Optional AI text assistance (report wording). The app works without these.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_TOKENS=6000
GEMINI_TIMEOUT_MS=
GEMINI_RETRIES=

# ---------------------------------------------------------------------------
# Uploaded documents (§8). The largest file the server will accept, in bytes;
# blank or unset means 25 MB. Anything bigger is refused before it is read.
# ---------------------------------------------------------------------------
DOCUMENT_MAX_BYTES=26214400
